# ==============================================================================
# BANCO DE DADOS (PostgreSQL 17 via Docker Compose)
# ==============================================================================
POSTGRES_DB=estudos
POSTGRES_USER=estudos
POSTGRES_PASSWORD=change-me-for-local-use
POSTGRES_PORT=5432

# Caso deseje sobrescrever a conexão JDBC no Spring Boot:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/estudos
# SPRING_DATASOURCE_USERNAME=estudos
# SPRING_DATASOURCE_PASSWORD=estudos-dev-only

# ==============================================================================
# INTEGRAÇÃO COM IA (OpenAI API — Exclusivo no Backend)
# NUNCA exponha a chave no frontend nem faça commit de um arquivo .env real.
# ==============================================================================
# Habilita ou desabilita explicitamente o provedor OpenAI (true/false)
OPENAI_ENABLED=true

# Chave secreta da API da OpenAI (ex.: sk-proj-...)
# Quando vazia, o sistema funciona normalmente e retorna HTTP 503 nas funções de IA.
OPENAI_API_KEY=

# Modelo padrão compatível com Chat Completions e saída JSON estruturada
OPENAI_MODEL=gpt-4o-mini

# Endpoint oficial da API de Chat Completions da OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Timeouts de rede (em segundos) para evitar bloqueio de threads
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_REQUEST_TIMEOUT_SECONDS=45

# Limites de proteção de custo e tamanho de contexto
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_INPUT_CHARS=40000
OPENAI_MAX_REQUESTS_PER_MINUTE=20
