# ==============================================================================
# BANCO DE DADOS (PostgreSQL 17 via Docker Compose)
# ==============================================================================
POSTGRES_DB=estudos
POSTGRES_USER=estudos
POSTGRES_PASSWORD=change-me-for-local-use
POSTGRES_PORT=5432

# Caso deseje sobrescrever a conexão JDBC no Spring Boot:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/estudos
# SPRING_DATASOURCE_USERNAME=estudos
# SPRING_DATASOURCE_PASSWORD=estudos-dev-only

# ==============================================================================
# INTEGRAÇÃO COM IA (OpenAI API — Exclusivo no Backend)
# NUNCA exponha a chave no frontend nem faça commit de um arquivo .env real.
# ==============================================================================
# Habilita ou desabilita explicitamente o provedor OpenAI (true/false)
OPENAI_ENABLED=true

# Chave secreta da API da OpenAI (ex.: sk-proj-...)
# Quando vazia, o sistema funciona normalmente e retorna HTTP 503 nas funções de IA.
OPENAI_API_KEY=

# Modelo padrão compatível com Chat Completions e saída JSON estruturada
OPENAI_MODEL=gpt-4o-mini

# Endpoint oficial da API de Chat Completions da OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Timeouts de rede (em segundos) para evitar bloqueio de threads
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_REQUEST_TIMEOUT_SECONDS=45

# Limites de proteção de custo e tamanho de contexto
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_INPUT_CHARS=40000
OPENAI_MAX_REQUESTS_PER_MINUTE=20

# ==============================================================================
# OUTROS PROVEDORES DE IA (opcionais — configure quantos quiser)
# O provedor de cada operação, o fallback, o modelo e o limite diário de chamadas
# são escolhidos em Configurações › Provedores de IA. As chaves ficam só aqui.
# ==============================================================================
# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high | xhigh | max (low é suficiente para questões e chat)
ANTHROPIC_EFFORT=low

# Google Gemini (tem plano gratuito) — crie a chave em https://aistudio.google.com/apikey
# Passo a passo no README, seção "Usar o Google Gemini".
GEMINI_ENABLED=true
GEMINI_API_KEY=
# Modelo recomendado pelo Google para projetos novos; alternativa mais leve: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# Quando o modelo principal esgota a cota diária (429 RPD), a chamada repete automaticamente
# com este modelo. Vazio usa o padrão gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_CONNECT_TIMEOUT_SECONDS=10
# Limite local por minuto para modelos sem limite conhecido; para os do plano gratuito a fila
# local já usa os valores reais (gemini-3.8-flash: 5/min, gemini-3.5-flash-lite: 15/min)
GEMINI_MAX_REQUESTS_PER_MINUTE=10
# Limite de tokens de saída por chamada (geração de simulados pede mais, mas o .env manda)
GEMINI_MAX_OUTPUT_TOKENS=4096
# Limites por dia do nível gratuito, exibidos em Configurações › Provedores de IA
GEMINI_FREE_TIER_DAILY_LIMITS=gemini-3.8-flash:20,gemini-3.5-flash-lite:500

# Provedor padrão das operações sem rota salva na tela de Configurações:
# openai | anthropic | gemini. Vazio: o primeiro com chave (ordem OpenAI, Anthropic, Gemini).
AI_PROVIDER=

# ==============================================================================
# Upload de arquivos (padrão: 10MB por arquivo e por requisição)
# ==============================================================================
# UPLOAD_MAX_FILE_SIZE=10MB
# UPLOAD_MAX_REQUEST_SIZE=10MB
